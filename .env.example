# Copy this file to .env and fill in real values before running the server.

# Port the server listens on
PORT=3000

# Set to "production" once you're running behind HTTPS (makes login cookies secure)
NODE_ENV=development

# --- Database (Turso — free, hosted, SQLite-compatible) ---
# Create a free account at https://turso.tech, create a database, then run:
#   turso db show <your-db-name> --url
#   turso db tokens create <your-db-name>
# and paste the results below.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=paste-your-token-here

# Long, random string used to sign login cookies (JSON Web Tokens). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# Email used for the very first admin account, auto-created on first run.
# A random password for it is printed to the server console the first time
# the server starts — sign in and change it right away.
ADMIN_BOOTSTRAP_EMAIL=admin@yourschool.edu
